{
  "name": "nb-pdf-TOOLS-web",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "engines": {
    "node": "20.x"
  },
  "scripts": {
    "prebuild": "node scripts/prebuild.mjs",
    "predev": "node scripts/prebuild.mjs",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "e2e": "playwright test",
    "e2e:install": "playwright install chromium --with-deps",
    "dev": "vite --host",
    "dev:with-pdf-api": "concurrently -k -n pdf,ui -c blue,magenta \"node ../../scripts/run-pdf-api.mjs\" \"vite --host\"",
    "dev:with-api": "concurrently -k -n api,ui -c green,magenta \"npm run dev --prefix ../api\" \"vite\"",
    "dev:fullstack": "npm run dev --prefix ../..",
    "build": "tsc && vite build && node scripts/inject-prerender-assets.mjs && node scripts/stamp-sw-version.mjs",
    "preview": "vite preview",
    "lint": "eslint src"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "^1.2.0",
    "@number-flow/react": "^0.6.2",
    "@pdf-lib/fontkit": "^1.1.1",
    "@sentry/react": "^10.75.0",
    "@tanstack/react-virtual": "^3.14.25",
    "clsx": "^2.1.1",
    "docx": "^9.15.1",
    "fflate": "^0.8.3",
    "framer-motion": "^12.38.0",
    "libphonenumber-js": "^1.13.15",
    "lucide-react": "^0.460.0",
    "onnxruntime-web": "^1.31.1",
    "pdf-lib": "^1.17.1",
    "pdfjs-dist": "^4.10.38",
    "pica": "^10.0.3",
    "qrcode": "^1.5.4",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "react-phone-number-input": "^3.4.18",
    "react-router-dom": "^7.18.5",
    "recharts": "^3.10.1",
    "scanic": "^1.7.1",
    "scanic-ml": "^0.2.0",
    "tailwind-merge": "^3.7.0",
    "tesseract.js": "^5.1.1",
    "utif2": "^4.1.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.64.1",
    "@sentry/vite-plugin": "^4.9.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^6.9.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.8",
    "@types/node": "^22.13.14",
    "@types/qrcode": "^1.5.6",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.2.0",
    "@vitest/coverage-v8": "^4.1.12",
    "concurrently": "^9.2.1",
    "esbuild": "^0.28.2",
    "eslint": "^10.14.0",
    "eslint-plugin-react-hooks": "^7.1.1",
    "ffmpeg-static": "^5.3.0",
    "javascript-obfuscator": "^5.9.1",
    "jsdom": "^29.1.1",
    "jsqr": "^1.4.0",
    "playwright": "^1.59.1",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.2.2",
    "typescript": "^6.0.2",
    "typescript-eslint": "^8.72.1",
    "vite": "^8.3.0",
    "vitest": "^4.1.12"
  }
}
