{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": "vite",
  "installCommand": "npm install --prefix web/frontend --no-audit --no-fund",
  "buildCommand": "npm run build --prefix web/frontend",
  "outputDirectory": "web/frontend/dist",
  "rewrites": [
    {
      "source": "/api",
      "destination": "https://httpbin.org/status/503"
    },
    {
      "source": "/api/:path*",
      "destination": "https://httpbin.org/status/503"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
